#!/bin/sh
set -eu
if [ ! -f /conf/ipv6-ha-before-native-config.xml ]; then
    install -m 600 /conf/config.xml /conf/ipv6-ha-before-native-config.xml
fi
# Keep the last standalone installation for a targeted rollback.
backup=/conf/ipv6-ha-standalone-backup
if [ -f /usr/local/sbin/ipv6-ha.py ] && [ ! -d "$backup" ]; then
    install -d -m 700 "$backup"
    cp -p /usr/local/sbin/ipv6-ha.py "$backup/"
    cp -p /usr/local/etc/ipv6-ha.json "$backup/"
    cp -p /usr/local/etc/rc.d/ipv6_ha "$backup/"
    cp -p /usr/local/etc/rc.syshook.d/carp/95-ipv6-ha "$backup/"
    cp -p /etc/rc.conf.d/ipv6_ha "$backup/rc.conf"
    cp -p /conf/config.xml "$backup/config.xml"
    chmod 600 "$backup"/*
fi
if [ -f /usr/local/etc/rc.d/ipv6_ha ]; then
    service ipv6_ha onestop || true
fi
